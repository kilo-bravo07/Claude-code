# ─────────────────────────────────────────────────────────────────────────
# Data provider selection
# ─────────────────────────────────────────────────────────────────────────
# "mock" -> always use synthetic demo data (clearly labeled "Demo Data" in the UI)
# "ga4"  -> always use the real GA4 provider (fails loudly if the vars below are missing)
# unset  -> uses GA4 automatically once GA4_PROPERTY_ID + auth vars below are set,
#           otherwise falls back to mock data.
DATA_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────
# GA4 property
# ─────────────────────────────────────────────────────────────────────────
# Analytics > Admin > Property Settings > Property ID (the numeric ID, not the
# "G-XXXXXXX" measurement ID).
GA4_PROPERTY_ID=

# ─────────────────────────────────────────────────────────────────────────
# GA4 authentication — pick ONE of the two options below.
# ─────────────────────────────────────────────────────────────────────────

# Option A: Service account (requires an admin to add the service account's
# email as a Viewer on the GA4 property under Admin > Property Access Management).
# Path to the downloaded service-account JSON key file. NEVER commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# Option B: Your own Google account via OAuth (recommended when you only have
# Viewer access yourself and can't get a service account added). See README.md
# "Connecting GA4 with your own Viewer account" for how to obtain these three values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# GA4 event name overrides
# ─────────────────────────────────────────────────────────────────────────
# The shopping-side events below are GA4's standard ecommerce events and
# rarely need changing. The checkout-step events are NOT standard GA4 events —
# they must match whatever custom events your GTM/gtag implementation fires
# for each checkout step. Update them to your actual event names.
GA4_EVENT_SESSION_START=session_start
GA4_EVENT_VIEW_ITEM=view_item
GA4_EVENT_ADD_TO_CART=add_to_cart
GA4_EVENT_BEGIN_CHECKOUT=begin_checkout
GA4_EVENT_CHECKOUT_STEP2=checkout_step_2
GA4_EVENT_CHECKOUT_STEP3=checkout_step_3
GA4_EVENT_CHECKOUT_STEP4=checkout_step_4
GA4_EVENT_CHECKOUT_STEP5=checkout_step_5
GA4_EVENT_PURCHASE=purchase

# Optional: a GA4 custom dimension that identifies "brand" if you report
# multiple brands/properties into one GA4 property. Leave blank for a single
# brand (the dashboard will label everything "Default").
# Format: "customEvent:your_dimension_name" or "customUser:your_dimension_name".
GA4_BRAND_DIMENSION=
