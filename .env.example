# ─────────────────────────────────────────────────────────────────────────
# Data provider selection
# ─────────────────────────────────────────────────────────────────────────
# "mock" -> always use synthetic demo data for every property (clearly
#           labeled "Demo Data" in the UI)
# "ga4"  -> always use the real GA4 provider for every property (fails
#           loudly per-property if that property's credentials are missing)
# unset  -> each of the four properties below is used with GA4 automatically
#           once ITS OWN property ID is set (and shared auth is configured),
#           otherwise that property falls back to mock data. One property
#           can be live while another still runs on demo data.
DATA_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────
# GA4 property IDs — one per property. Set only the ones you have.
# ─────────────────────────────────────────────────────────────────────────
# Find each one at: GA4 → Admin (gear icon) → Property Settings → "Property ID"
# (the numeric ID, not the "G-XXXXXXX" measurement ID).
FLOWERAURA_WEB_GA4_PROPERTY_ID=
FLOWERAURA_APP_GA4_PROPERTY_ID=
BAKINGO_WEB_GA4_PROPERTY_ID=
BAKINGO_APP_GA4_PROPERTY_ID=

# ─────────────────────────────────────────────────────────────────────────
# GA4 authentication — shared across all four properties. Pick ONE option.
# ─────────────────────────────────────────────────────────────────────────

# Option A: Service account (requires an admin to add the service account's
# email as a Viewer on EACH GA4 property under Admin > Property Access Management).
# Path to the downloaded service-account JSON key file. NEVER commit this file.
GOOGLE_APPLICATION_CREDENTIALS=

# Option B: Your own Google account via OAuth (recommended when you only have
# Viewer access yourself and can't get a service account added — works as
# long as your account has Viewer access on whichever properties you connect).
# See README.md "Connecting GA4" for how to obtain these three values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Event names and funnel shapes
# ─────────────────────────────────────────────────────────────────────────
# Unlike the property ID, event names are NOT set here — each property's
# exact funnel (event names, stage order, labels, special metrics like
# FlowerAura App's "New ECR") is defined once in its own config file:
#   lib/properties/floweraura-web.ts
#   lib/properties/floweraura-app.ts
#   lib/properties/bakingo-web.ts
#   lib/properties/bakingo-app.ts
# If your real GA4 events differ from what's in one of these files, edit
# that file directly (see README.md "Connecting GA4" for guidance).
